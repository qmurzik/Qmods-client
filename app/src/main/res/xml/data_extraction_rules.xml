<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is disabled and no auto-backup / device-transfer rules are declared,
     so the DataStore file holding the session token is never included in backups or
     cloud/device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
